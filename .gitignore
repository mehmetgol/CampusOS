.idea/
*.sln.iml

# ==========================================
# React / Vite / Node.js
# ==========================================

node_modules/
frontend/node_modules/

dist/
frontend/dist/

.vite/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
